# HTML validation scanner (VNU)
tests/e2e/html-report/reports/*
!tests/e2e/html-report/reports/.gitkeep

# Accessibility scanner (pa11y-ci)
tests/e2e/pa11y-report/reports/*
!tests/e2e/pa11y-report/reports/.gitkeep

# Issues snapshots (private backlog data, never commit)
tests/e2e/issues-report/reports/*
!tests/e2e/issues-report/reports/.gitkeep
# Site-specific pages to scan (private, one per developer)
tests/e2e/pa11y-report/pa11yci.urls.local.json

